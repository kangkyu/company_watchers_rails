<div class="bg-surface border-b border-border py-4 mb-6">
  <div class="max-w-7xl mx-auto px-4 flex items-center justify-between gap-4 flex-wrap">
    <h1 class="text-xl text-gray-900 flex items-center gap-2">
      <span class="text-2xl">&#128202;</span> Company Watchers
    </h1>
    <div class="flex items-center gap-3">
      <%= form_with url: root_path, method: :get, local: true, data: { turbo: false } do %>
        <div class="flex gap-2">
          <input type="text" name="search" value="<%= params[:search] %>" placeholder="Search news or ticker..." class="bg-white border border-border text-gray-900 px-3 py-2 rounded-md text-sm w-56 focus:outline-none focus:border-accent">
        </div>
      <% end %>
      <% if session[:admin] %>
        <%= link_to "Admin", admin_path, class: "text-muted text-sm px-3 py-2 rounded-md hover:bg-surface-hover transition-colors" %>
      <% else %>
        <%= link_to "Admin", admin_login_path, class: "text-muted text-sm px-3 py-2 rounded-md hover:bg-surface-hover transition-colors" %>
      <% end %>
    </div>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4">
  <div class="flex gap-6 mb-6 text-sm text-muted">
    <span><strong class="text-gray-900"><%= @total_items %></strong> news items</span>
    <span><strong class="text-gray-900"><%= @company_count %></strong> companies</span>
  </div>

  <% if @news_items.empty? %>
    <div class="text-center py-16 text-muted">
      <p>No news yet. Add some companies and sync from the admin panel.</p>
    </div>
  <% else %>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-4 pb-8">
      <% @news_items.each do |item| %>
        <div class="group bg-surface rounded-xl overflow-hidden border border-border transition-transform hover:-translate-y-0.5 hover:shadow-lg relative flex flex-col">
          <% if session[:admin] %>
            <%= button_to "Delete", news_item_path(item), method: :delete, class: "absolute top-1.5 right-1.5 bg-black/70 text-red-300 border-none rounded px-2 py-1 text-xs cursor-pointer z-10 opacity-0 group-hover:opacity-100 transition-opacity", data: { turbo_confirm: "Delete this news item?" } %>
          <% end %>
          <a href="<%= item.url %>" target="_blank" rel="noopener" class="block flex-1 flex flex-col">
            <% if item.image.present? %>
              <div class="relative w-full pt-[56.25%] overflow-hidden bg-gray-100">
                <img src="<%= item.image %>" alt="<%= item.title %>" loading="lazy" class="absolute inset-0 w-full h-full object-cover">
              </div>
            <% end %>
            <div class="p-3 flex-1 flex flex-col">
              <div class="flex items-center gap-2 mb-2">
                <span class="bg-accent text-white text-xs font-semibold px-2 py-0.5 rounded"><%= item.company.symbol %></span>
                <span class="text-xs text-muted truncate"><%= item.company.name %></span>
              </div>
              <div class="text-sm font-medium leading-snug line-clamp-3 mb-2"><%= item.title %></div>
              <div class="text-xs text-muted mt-auto flex gap-2 justify-between">
                <span class="truncate"><%= item.source.presence || item.site %></span>
                <span class="shrink-0"><%= item.time_ago %></span>
              </div>
            </div>
          </a>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
