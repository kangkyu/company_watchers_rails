<%= tag.li id: dom_id(company), class: "flex items-center gap-4 py-3 border-b border-border last:border-b-0" do %>
  <% if company.image.present? %>
    <a href="<%= company.website %>" target="_blank" class="shrink-0 w-16 h-16 rounded-md overflow-hidden block bg-gray-100">
      <img src="<%= company.image %>" alt="<%= company.symbol %>" class="w-full h-full object-contain">
    </a>
  <% else %>
    <div class="shrink-0 w-16 h-16 rounded-md bg-gray-100 flex items-center justify-center text-xs font-semibold text-muted">
      <%= company.symbol %>
    </div>
  <% end %>
  <div class="flex-1 min-w-0">
    <div class="flex items-baseline gap-2">
      <strong class="text-sm"><%= company.symbol %></strong>
      <span class="text-sm text-muted truncate"><%= company.name %></span>
    </div>
    <div class="text-xs text-muted mt-0.5">
      <%= [ company.sector, company.industry ].compact_blank.join(" / ") %>
    </div>
    <div class="text-xs text-muted mt-0.5 flex gap-3">
      <% if company.market_cap.present? %><span>Mkt cap <%= company.market_cap %></span><% end %>
      <% if company.country.present? %><span><%= company.country %></span><% end %>
      <span><%= company.news_items.size %> news</span>
    </div>
  </div>
  <div class="flex gap-2 shrink-0">
    <%= button_to "Sync news", sync_news_company_path(company), method: :post, class: "btn btn-sm" %>
    <% if company.draft? %>
      <%= button_to "Pick", toggle_pick_company_path(company), method: :patch, class: "btn btn-sm", form: { data: { turbo_stream: true } } %>
    <% else %>
      <%= button_to "Unpick", toggle_pick_company_path(company), method: :patch, class: "btn btn-sm btn-primary", form: { data: { turbo_stream: true } } %>
    <% end %>
    <%= button_to "Remove", company_path(company), method: :delete, class: "btn btn-sm btn-danger", data: { turbo_confirm: "Remove #{company.symbol}?" } %>
  </div>
<% end %>
